<body class=\"c body\">\n<div style=\"padding-bottom: 8px; padding-top: 1px\">\n<div id=\"IDX\" style=\"padding-bottom: 8px; padding-top: 1px\">\n<table class=\"table\" style=\"border-spacing: 0\" aria-label=\"Query Results\">\n<caption aria-label=\"Query Results\"></caption>\n<colgroup><col/><col/><col/><col/><col/><col/></colgroup>\n<thead>\n<tr>\n<th class=\"b header\" scope=\"col\">ScientificName</th>\n<th class=\"b header\" scope=\"col\">Species</th>\n<th class=\"b header\" scope=\"col\">specificEpithet</th>\n<th class=\"b header\" scope=\"col\">CommonName</th>\n<th class=\"b header\" scope=\"col\">Description</th>\n<th class=\"b header\" scope=\"col\">Source</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td class=\"data\">Agapostemon virescens</td>\n<td class=\"data\">Agapostemon</td>\n<td class=\"data\">virescens</td>\n<td class=\"data\">Bicolored Striped Sweat Bee</td>\n<td class=\"data\">Widespread in North America; favors asters and sunflowers; active in the afternoon; family Halictidae.</td>\n<td class=\"data\">Discover Life</td>\n</tr>\n<tr>\n<td class=\"data\">Apis mellifera</td>\n<td class=\"data\">Apis</td>\n<td class=\"data\">mellifera</td>\n<td class=\"data\">Western Honey Bee</td>\n<td class=\"data\">Found globally; enjoys a wide range of flowers; active throughout the day; family Apidae.</td>\n<td class=\"data\">Discover Life</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus affinis</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">affinis</td>\n<td class=\"data\">Rusty Patched Bumblebee</td>\n<td class=\"data\">Found in the eastern U.S.; favors wildflowers and garden plants; active during the day; family Apidae.</td>\n<td class=\"data\">IUCN Red List</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus appositus</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">appositus</td>\n<td class=\"data\">White-shouldered Bumblebee</td>\n<td class=\"data\">Found in woodlands and gardens; enjoys clover and thistles; active during the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus balteatus</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">balteatus</td>\n<td class=\"data\">Golden-belted Bumblebee</td>\n<td class=\"data\">Found in western U.S.; prefers wildflowers and garden plants; active throughout the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus bifarius</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">bifarius</td>\n<td class=\"data\">Two-form Bumblebee</td>\n<td class=\"data\">Found in various North American habitats; enjoys flowering plants; active during the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus bimaculatus</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">bimaculatus</td>\n<td class=\"data\">Two-spotted Bumblebee</td>\n<td class=\"data\">Found in northeastern U.S.; enjoys clover and meadow flowers; active throughout the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus borealis</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">borealis</td>\n<td class=\"data\">Northern Amber Bumblebee</td>\n<td class=\"data\">Found in northern U.S. and Canada; enjoys wildflowers and garden plants; active during the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus flavifrons</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">flavifrons</td>\n<td class=\"data\">Yellow-fronted Bumblebee</td>\n<td class=\"data\">Found in U.S.; enjoys wildflowers and garden plants; active during the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n<tr>\n<td class=\"data\">Bombus fraternus</td>\n<td class=\"data\">Bombus</td>\n<td class=\"data\">fraternus</td>\n<td class=\"data\">Southern Plains Bumblebee</td>\n<td class=\"data\">Found in southern U.S.; enjoys a variety of wildflowers; active during the day; family Apidae.</td>\n<td class=\"data\">Bumblebees of</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</body>\n</html>\n","mime":"application/vnd.sas.ods.html5"},{"data":"[\n\t{\n\t\t\"line\": \"915  /** LOG_START_INDICATOR **/\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"27                                                         The SAS System                     Friday, September  5, 2025 09:07:00 PM\",\n\t\t\"type\": \"title\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"\",\n\t\t\"type\": \"title\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"916  title;footnote;ods _all_ close;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"917  ods graphics on;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"918  ods html5(id=vscode) style=HTMLEncore options(bitmap_mode='inline' svg_mode='inline');\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: Writing HTML5(VSCODE) Body file: sashtml36.htm\",\n\t\t\"type\": \"note\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"919  %let _SASPROGRAMFILE = %nrquote(%nrstr(/workspaces/myfolder/Pharmasug25/procsql.sasnb));\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"920  proc sql outobs=10;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"921      select *\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"922      from dst3\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"923      where prxmatch('/(ed|ern)(\\\\s|-)|\\\\-/i', commonname);\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"WARNING: Statement terminated early due to OUTOBS=10 option.\",\n\t\t\"type\": \"warning\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"924  quit;\",\n\t\t\"type\": \"source\",\n\t\t\"version\": 1\n\t},\n\t{\n\t\t\"line\": \"NOTE: PROCEDURE SQL used (Total process time):\",\n\t\t